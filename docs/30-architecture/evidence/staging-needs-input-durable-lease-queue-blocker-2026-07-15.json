  "root_cause": "The client read model translated assignment_result_status=needs_input to waiting_for_user, but the durable scheduler retained the provider-supplied running state. The active lease therefore blocked the next same-agent assignment until stale lease expiry.",
  "fix_contract": {
    "durable_state_for_running_needs_input": "completed",
    "client_projection": "waiting_for_user",
    "next_same_agent_poll": "start_queued_assignment"
  },
