        "description": "agent를 현재 수정할 수 있는지 나타냅니다.",
        "enum": [
          "editable",
          "blocked_assigned_tasks"
        ],
        "type": "string"
      },
      "AgentEditabilityChangedEvent": {
        "description": "agent 수정 가능 여부 변경을 전달하는 SSE event입니다.",
        "properties": {
          "agent_id": {
            "type": "string"
          },
          "assigned_task_count": {
            "type": "integer"
          },
          "editability": {
            "$ref": "#/components/schemas/AgentEditability"
          },
          "event_type": {
            "enum": [
              "agent_editability_changed"
            ],
            "type": "string"
          },
          "schema_version": {
            "type": "string"
          }
        },
        "required": [
          "event_type",
          "schema_version",
          "agent_id",
          "editability"
        ],
        "type": "object"
      },
