          "agent_id": {
            "type": "string"
          },
          "assigned_task_count": {
            "type": "integer"
          },
          "editability": {
            "$ref": "#/components/schemas/AgentEditability"
          },
          "reason": {
            "type": "string"
          },
          "schema_version": {
            "type": "string"
          }
        },
        "required": [
          "schema_version",
          "agent_id",
          "editability",
          "assigned_task_count"
        ],
        "type": "object"
      },
      "AgentTaskCommentKind": {
        "description": "Figma comment 소통 흐름에서 task thread에 기록되는 상태 update 종류입니다.",
        "enum": [
          "queued_by_busy_agent",
          "stopped_by_agent_deleted",
          "stopped_by_user_request",
          "runtime_progress",
          "task_completed",
          "task_failed"
        ],
        "type": "string"
      },
      "AgentVisibility": {
        "description": "agent의 workspace 공개 범위입니다.",
        "enum": [
          "public",
          "private"
        ],
        "type": "string"
      },
      "AgentWorkStatus": {
        "description": "runtime output과 task assignment state에서 파생된 client 표시용 agent 작업 상태입니다.",
        "enum": [
          "idle",
          "queued",
          "running",
          "waiting_for_user",
          "completed",
          "failed",
          "offline"
        ],
        "type": "string"
      },
      "AgentWorkStatusChangedEvent": {
        "description": "agent 작업 상태와 task thread comment 상태 변경을 전달하는 SSE event입니다.",
        "properties": {
          "agent_id": {
            "type": "string"
          },
          "assignment_state": {
            "$ref": "#/components/schemas/AgentAssignmentState"
          },
          "comment_kind": {
            "$ref": "#/components/schemas/AgentTaskCommentKind"
          },
          "event_type": {
            "enum": [
              "agent_work_status_changed"
            ],
            "type": "string"
          },
          "run_id": {
            "type": "string"
          },
          "schema_version": {
            "type": "string"
          },
          "task_id": {
            "type": "string"
          },
          "work_status": {
            "$ref": "#/components/schemas/AgentWorkStatus"
          }
        },
        "required": [
          "event_type",
          "schema_version",
          "agent_id",
          "work_status"
        ],
        "type": "object"
      },
      "ClientBootstrapResponse": {
        "description": "AI Agent 화면 진입 시 필요한 agent와 device runtime 초기 데이터입니다.",
        "properties": {
          "agents": {
            "items": {
              "$ref": "#/components/schemas/AgentClientRecord"
            },
            "type": "array"
          },
          "client_kind": {
            "$ref": "#/components/schemas/ClientKind"
          },
          "devices": {
            "items": {
              "$ref": "#/components/schemas/DeviceRecord"
