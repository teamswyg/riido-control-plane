        "description": "web과 desktop webview client가 소비하는 SSE event union입니다.",
        "discriminator": {
          "mapping": {
            "agent_editability_changed": "#/components/schemas/AgentEditabilityChangedEvent",
            "agent_work_status_changed": "#/components/schemas/AgentWorkStatusChangedEvent",
            "device_runtime_snapshot": "#/components/schemas/DeviceRuntimeSnapshotEvent"
          },
          "propertyName": "event_type"
        },
        "oneOf": [
          {
            "$ref": "#/components/schemas/DeviceRuntimeSnapshotEvent"
          },
          {
            "$ref": "#/components/schemas/AgentEditabilityChangedEvent"
          },
          {
            "$ref": "#/components/schemas/AgentWorkStatusChangedEvent"
          }
        ]
      },
