        "description": "task thread action 요청 이후 client가 즉시 반영할 agent 작업 상태 응답입니다.",
        "properties": {
          "agent_id": {
            "type": "string"
          },
          "assignment_state": {
            "$ref": "#/components/schemas/AgentAssignmentState"
          },
          "comment_kind": {
            "$ref": "#/components/schemas/AgentTaskCommentKind"
          },
          "message": {
            "type": "string"
          },
          "run_id": {
            "type": "string"
          },
          "schema_version": {
            "type": "string"
          },
          "task_id": {
            "type": "string"
          },
          "work_status": {
            "$ref": "#/components/schemas/AgentWorkStatus"
          }
        },
        "required": [
          "schema_version",
          "task_id",
          "agent_id",
          "run_id",
          "work_status",
          "assignment_state",
          "comment_kind",
          "message"
        ],
        "type": "object"
      },
