        "description": "agent 삭제와 runtime lifecycle에 의해 변경되는 task assignment 상태입니다.",
        "enum": [
          "queued",
          "running",
          "stopping",
          "stopped",
          "completed",
          "failed",
          "unassigned"
        ],
        "type": "string"
      },
      "AgentClientListResponse": {
        "description": "task 또는 화면에서 표시할 agent 목록 응답입니다.",
        "properties": {
          "agents": {
            "items": {
              "$ref": "#/components/schemas/AgentClientRecord"
            },
            "type": "array"
          },
          "schema_version": {
            "type": "string"
          }
        },
        "required": [
          "schema_version",
          "agents"
        ],
        "type": "object"
      },
      "AgentClientRecord": {
        "description": "client 화면에 표시하는 agent 요약 record입니다.",
        "properties": {
          "agent_id": {
            "type": "string"
          },
          "assigned_task_count": {
            "type": "integer"
          },
          "editability": {
            "$ref": "#/components/schemas/AgentEditability"
          },
          "is_owned_by_viewer": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "owner_principal_id": {
            "type": "string"
          },
          "runtime_id": {
            "type": "string"
          },
          "runtime_kind": {
            "$ref": "#/components/schemas/RuntimeKind"
          },
          "visibility": {
            "$ref": "#/components/schemas/AgentVisibility"
          },
          "work_status": {
            "$ref": "#/components/schemas/AgentWorkStatus"
          }
        },
        "required": [
          "agent_id",
          "owner_principal_id",
          "is_owned_by_viewer",
          "name",
          "visibility",
          "work_status",
          "editability",
          "assigned_task_count"
        ],
        "type": "object"
      },
      "AgentClientRecordResponse": {
        "description": "단일 agent 변경 후 최신 agent record를 반환하는 응답입니다.",
        "properties": {
          "agent": {
            "$ref": "#/components/schemas/AgentClientRecord"
          },
          "schema_version": {
            "type": "string"
          }
        },
        "required": [
          "schema_version",
          "agent"
        ],
        "type": "object"
      },
