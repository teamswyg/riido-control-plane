  "context": "ai_agent_client",
  "service": {
    "name": "riido-control-plane",
    "schema_version": "riido-ai-server.v1"
  },
  "resources": [
    {
      "name": "agent",
      "owner_field": "owner_principal_id",
      "visibility": [
        {
          "name": "public",
          "read": [
            "admin",
            "owner",
            "user"
          ],
          "write": [
            "admin",
            "owner"
          ]
        },
        {
          "name": "private",
          "read": [
            "admin",
            "owner"
          ],
          "write": [
            "admin",
            "owner"
          ]
        }
      ]
    },
