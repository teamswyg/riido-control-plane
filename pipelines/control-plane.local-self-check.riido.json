    {
      "id": "collect-migration-ledger-evidence",
      "kind": "artifact",
      "paths": [
        "out/migration-ledger-evidence.json",
        "out/executable-knowledge-coverage.json"
      ],
      "redaction": "required",
      "run_when": "always"
    },
    {
      "id": "verify-syntax-hash-golden-locks",
      "kind": "shell",
