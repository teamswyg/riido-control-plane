  "steps": [
    {
      "id": "checkout",
      "kind": "checkout",
      "fetch_depth": 0
    },
    {
      "id": "verify-baseline-ci-parity",
      "kind": "shell",
      "command": "go run ./tools/ciworkflowparity -repo-root . -contract config/ci/baseline-go-workflow-parity.riido.json -evidence-out out/baseline-ci-parity-evidence.json"
    },
    {
      "id": "verify-go-dependency-allowlist",
      "kind": "shell",
      "command": "mkdir -p out && go run ./tools/dependencyallowlist -contract dependency_allowlist.riido.json -evidence-out out/dependency-allowlist-evidence.json"
    },
    {
      "id": "collect-baseline-policy-evidence",
      "kind": "artifact",
      "paths": [
        "out/baseline-ci-parity-evidence.json",
        "out/dependency-allowlist-evidence.json"
      ],
      "redaction": "required",
      "run_when": "always"
    },
    {
      "id": "test-control-plane",
      "kind": "shell",
      "command": "go test ./..."
    },
    {
      "id": "verify-repository-readme",
      "kind": "shell",
      "command": "umask 077 && mkdir -p out && go test ./tools/repositoryreadme -count=1 && go run ./tools/repositoryreadme -check-doc -evidence-out out/repository-readme-evidence.json"
    },
    {
      "id": "verify-executable-knowledge",
      "kind": "shell",
      "command": "umask 077 && go run ./tools/knowledgecoverage -check-doc -evidence-out out/executable-knowledge-coverage.json"
    },
    {
      "id": "collect-repository-readme-evidence",
      "kind": "artifact",
      "paths": [
        "out/repository-readme-evidence.json",
        "out/executable-knowledge-coverage.json"
      ],
      "redaction": "required",
      "run_when": "always"
    },
    {
      "id": "verify-context-map",
      "kind": "shell",
      "command": "umask 077 && mkdir -p out && go test ./tools/contextmap -count=1 && go run ./tools/contextmap -check-doc -evidence-out out/control-plane-context-map-evidence.json"
    },
    {
      "id": "collect-context-map-evidence",
      "kind": "artifact",
      "paths": [
        "out/control-plane-context-map-evidence.json"
      ],
      "redaction": "required",
      "run_when": "always"
    },
    {
      "id": "download-go-ci-modules",
      "kind": "shell",
      "command": "go mod download"
    },
    {
      "id": "verify-go-ci-baseline",
      "kind": "shell",
      "command": "umask 077 && mkdir -p out && go test ./tools/gocibaseline -count=1 && go run ./tools/gocibaseline -check-doc -evidence-out out/go-ci-baseline-evidence.json"
    },
    {
      "id": "install-go-ci-lint",
      "kind": "shell",
      "command": "mkdir -p bin && GOBIN=\"$PWD/bin\" go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@v2.12.2"
    },
    {
      "id": "lint-go-ci",
      "kind": "shell",
      "command": "bin/golangci-lint run ./... --timeout=5m"
    },
    {
      "id": "test-go-ci-with-coverage",
      "kind": "shell",
      "command": "mkdir -p out && go test ./... -coverprofile=out/go-test-cover.out -covermode=count && go tool cover -func=out/go-test-cover.out | tee out/go-test-coverage-summary.txt && chmod 0600 out/go-test-cover.out out/go-test-coverage-summary.txt"
    },
    {
      "id": "collect-go-ci-quality-evidence",
      "kind": "artifact",
      "paths": [
        "out/go-ci-baseline-evidence.json",
        "out/go-test-cover.out",
        "out/go-test-coverage-summary.txt"
      ],
      "redaction": "required",
      "run_when": "always"
    },
    {
      "id": "verify-module-decomposition",
      "kind": "shell",
      "command": "umask 077 && mkdir -p out && go test ./tools/moduledecomposition -count=1 && go run ./tools/moduledecomposition -check-doc -evidence-out out/module-decomposition-evidence.json"
    },
    {
      "id": "verify-module-executable-knowledge",
      "kind": "shell",
      "command": "umask 077 && go run ./tools/knowledgecoverage -check-doc -evidence-out out/executable-knowledge-coverage.json"
    },
    {
      "id": "collect-module-decomposition-evidence",
      "kind": "artifact",
      "paths": [
        "out/module-decomposition-evidence.json",
        "out/executable-knowledge-coverage.json"
      ],
      "redaction": "required",
      "run_when": "always"
    },
    {
      "id": "verify-pre-commit-baseline",
      "kind": "shell",
      "command": "umask 077 && mkdir -p out && go test ./tools/precommitbaseline -count=1 && go run ./tools/precommitbaseline -check-doc -evidence-out out/pre-commit-baseline-evidence.json"
    },
    {
