{
  "schema_version": "riido-ci-pipeline.v1",
  "id": "control-plane-local-self-check",
  "status": "active",
  "repo": "riido-control-plane",
  "visibility": "private",
  "execution": {
    "default_engine": "wasm",
    "native_policy": "explicit",
    "attestation": "required"
  },
  "worker": {
    "labels": ["local", "go", "riido-ci"],
    "timeout_minutes": 10
  },
  "env": {
    "RIIDO_CI_MODE": "local",
    "RIIDO_EVIDENCE_REDACTION": "required",
    "GOPRIVATE": "github.com/teamswyg/*",
    "GONOSUMDB": "github.com/teamswyg/*"
  },
  "evidence_contract": {
    "artifact": "control-plane-local-self-check-evidence",
    "source_check_boundary": "local_repo",
    "owner_packages": [
      "dependency_allowlist.riido.json",
      "go.mod",
      "go.sum",
      "tools/dependencyallowlist",
      "tools/ciworkflowparity",
      "tools/repositoryreadme",
      "tools/knowledgecoverage",
      "tools/contextmap",
      "tools/riido-ci-local",
      "config/ci",
      "pipelines"
    ],
    "cases": [
      {
        "name": "local-run-envelope",
        "kind": "result-evidence-envelope",
        "want_schema_version": "riido-ci-local-run-evidence.v1",
        "want_decision": "passed",
        "want_artifact_sha256_present": true
      },
      {
        "name": "baseline-ci-parity-evidence",
        "kind": "artifact-integrity",
        "want_paths": ["out/baseline-ci-parity-evidence.json"],
        "want_sha256_present": true
      },
      {
        "name": "dependency-allowlist-evidence",
        "kind": "artifact-integrity",
        "want_paths": ["out/dependency-allowlist-evidence.json"],
        "want_sha256_present": true
      },
      {
        "name": "repository-readme-evidence",
        "kind": "artifact-integrity",
        "want_paths": ["out/repository-readme-evidence.json"],
        "want_sha256_present": true,
        "want_json_schema_version": "riido-control-plane-repository-readme-evidence.v1"
      },
      {
        "name": "executable-knowledge-evidence",
        "kind": "artifact-integrity",
        "want_paths": ["out/executable-knowledge-coverage.json"],
        "want_sha256_present": true,
        "want_json_schema_version": "riido-executable-knowledge-coverage-result.v1"
      },
      {
        "name": "context-map-evidence",
        "kind": "artifact-integrity",
        "want_paths": ["out/control-plane-context-map-evidence.json"],
        "want_sha256_present": true,
        "want_json_schema_version": "riido-control-plane-context-map-evidence.v1"
      }
    ],
    "source_checks": [
      {
        "name": "baseline-go-ci-parity-contract",
        "file": "config/ci/baseline-go-workflow-parity.riido.json",
        "contains": [
          "riido-control-plane-baseline-ci-parity.v1",
          "74430b5f9001bdd6d384c4bae985d7914f825f998b47ffe22826f480e4789f1c",
          "ae953f656aba408e154b10a7d4bd782169fa51fc93ddd618e2d3313a5b82e58c",
          "3abfc4a36a0e9121996116a8010b56769a75d30915c64d394761c552ccae5392",
          "https://github.com/teamswyg/riido-control-plane/issues/1039",
          "https://github.com/teamswyg/riido-control-plane/issues/1041",
          "4795cdebfcf4bccaa71ec2344368ad9adf6b1974",
          "required_adapter_count",
          "workflow_retirement_authorized",
          "source_workflow_edited"
        ]
      },
      {
        "name": "baseline-go-ci-parity-verifier-identity",
        "file": "tools/ciworkflowparity/constants.go",
        "contains": [
          "riido-control-plane-baseline-ci-parity-evidence.v1",
          "riido-control-plane-baseline-ci-parity.v1"
        ]
      },
      {
        "name": "baseline-go-ci-parity-case-matrix",
        "file": "tools/ciworkflowparity/verify.go",
        "contains": [
          "legacy_workflow_digest_is_exact",
          "native_pipeline_preserves_step_order",
          "runner_is_pinned_and_credential_free",
          "retirement_and_runtime_authority_remain_zero"
        ]
      },
      {
        "name": "repository-readme-parity-case-matrix",
        "file": "tools/ciworkflowparity/verify.go",
        "contains": [
          "repository_readme_workflow_digest_is_exact",
          "repository_readme_steps_are_native",
          "repository_readme_pipeline_preserves_order",
          "repository_readme_authority_remains_zero"
        ]
      },
      {
        "name": "repository-readme-parity-boundary",
        "file": "tools/ciworkflowparity/verify_readme_child.go",
        "contains": [
          "ae953f656aba408e154b10a7d4bd782169fa51fc93ddd618e2d3313a5b82e58c",
          "umask 077",
          "repository_readme_native_parity_source_complete",
          "retain_exact_baseline_until_separate_retirement_parity_review"
        ]
      },
      {
        "name": "context-map-parity-case-matrix",
        "file": "tools/ciworkflowparity/verify_context_map_cases.go",
        "contains": [
          "context_map_workflow_digest_is_exact",
          "context_map_steps_are_native",
          "context_map_pipeline_preserves_order",
          "context_map_authority_remains_zero",
          "context_map_native_parity_source_complete"
        ]
      },
      {
        "name": "context-map-parity-boundary",
        "file": "tools/ciworkflowparity/verify_context_map_child.go",
        "contains": [
          "3abfc4a36a0e9121996116a8010b56769a75d30915c64d394761c552ccae5392",
          "umask 077",
          "ContextMapCommandExact",
          "actions/upload-artifact@v7"
        ]
      },
      {
        "name": "baseline-go-ci-parity-secure-evidence",
        "file": "tools/ciworkflowparity/write_evidence.go",
        "contains": [
          "0o600"
        ]
      },
      {
        "name": "dependency-allowlist-contract",
        "file": "dependency_allowlist.riido.json",
        "contains": [
          "riido-go-dependency-allowlist.v2",
          "control-plane-go-dependency-allowlist",
          "approved direct Go module dependencies",
          "machine-verifiable"
        ]
      },
      {
        "name": "exact-central-runner",
        "file": "tools/riido-ci-local",
        "contains": [
          "4795cdebfcf4bccaa71ec2344368ad9adf6b1974",
          "riido-ci checkout must be clean",
          "riido-ci evidence must be mode 0600",
          "-u AWS_ACCESS_KEY_ID",
          "-u GH_TOKEN"
        ]
      }
    ],
    "forbidden_terms": [
      "BEGIN PRIVATE KEY",
      "gho_",
      "AKIA"
    ],
    "forbidden_term_files": [
      "config/ci/baseline-go-workflow-parity.riido.json"
    ],
    "loop": {
      "observation": "The baseline Go workflow is fully native in the current migration draft, but no exact local parity receipt is owned by Control Plane.",
      "hypothesis": "A pinned credential-free local pipeline can preserve dependency policy, failure artifact semantics and the exact full-test command before any owner-reviewed workflow retirement.",
      "execute": "Verify the unchanged legacy workflow digest and exact mapping, run dependency allowlist evidence, preserve it through the native always artifact step, then run the full Go test suite.",
      "evaluate": "Require exact source and runner pins, zero adapters, mode-0600 parity and local-run evidence, content-addressed artifacts and no workflow or runtime authority.",
      "retrospective": "Keep the legacy workflow and blocked private-policy evidence until a separate owner-reviewed retirement change proves the replacement and rollback."
    }
  },
  "steps": [
    {
      "id": "checkout",
      "kind": "checkout",
      "fetch_depth": 0
    },
    {
      "id": "verify-baseline-ci-parity",
      "kind": "shell",
      "command": "go run ./tools/ciworkflowparity -repo-root . -contract config/ci/baseline-go-workflow-parity.riido.json -evidence-out out/baseline-ci-parity-evidence.json"
    },
    {
      "id": "verify-go-dependency-allowlist",
      "kind": "shell",
      "command": "mkdir -p out && go run ./tools/dependencyallowlist -contract dependency_allowlist.riido.json -evidence-out out/dependency-allowlist-evidence.json"
    },
    {
      "id": "collect-baseline-policy-evidence",
      "kind": "artifact",
      "paths": [
        "out/baseline-ci-parity-evidence.json",
        "out/dependency-allowlist-evidence.json"
      ],
      "redaction": "required",
      "run_when": "always"
    },
    {
      "id": "test-control-plane",
      "kind": "shell",
      "command": "go test ./..."
    },
    {
      "id": "verify-repository-readme",
      "kind": "shell",
      "command": "umask 077 && mkdir -p out && go test ./tools/repositoryreadme -count=1 && go run ./tools/repositoryreadme -check-doc -evidence-out out/repository-readme-evidence.json"
    },
    {
      "id": "verify-executable-knowledge",
      "kind": "shell",
      "command": "umask 077 && go run ./tools/knowledgecoverage -check-doc -evidence-out out/executable-knowledge-coverage.json"
    },
    {
      "id": "collect-repository-readme-evidence",
      "kind": "artifact",
      "paths": [
        "out/repository-readme-evidence.json",
        "out/executable-knowledge-coverage.json"
      ],
      "redaction": "required",
      "run_when": "always"
    },
    {
      "id": "verify-context-map",
      "kind": "shell",
      "command": "umask 077 && mkdir -p out && go test ./tools/contextmap -count=1 && go run ./tools/contextmap -check-doc -evidence-out out/control-plane-context-map-evidence.json"
    },
    {
      "id": "collect-context-map-evidence",
      "kind": "artifact",
      "paths": [
        "out/control-plane-context-map-evidence.json"
      ],
      "redaction": "required",
      "run_when": "always"
    }
  ],
  "success_gate": [
    "legacy baseline workflow digest remains exact and unedited",
    "all five baseline job steps map to native riido-ci behavior with zero adapters",
    "dependency allowlist evidence is redacted and content-addressed",
    "full Go tests pass",
    "legacy workflow retirement and runtime authority remain zero",
    "riido-ci emits a passed mode-0600 local-run evidence envelope",
    "repository-readme workflow digest remains exact and unedited",
    "README and executable-knowledge commands map with zero adapters",
    "repository evidence is redacted, content-addressed and mode 0600",
    "context-map workflow digest remains exact and unedited",
    "dependency policy and the Context Map command map with zero adapters",
    "Context Map evidence is redacted, content-addressed and mode 0600"
  ]
}
